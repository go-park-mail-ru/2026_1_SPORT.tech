# Полный набор переменных для поднятия стека под нагрузочное тестирование.
# Значения тестовые — не для прода. Используется так:
#   docker compose --env-file perf_test/.env.perf up -d db content-service

DB_USER=postgres
DB_PASSWORD=sport

MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

PROFILE_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/avatars
CONTENT_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/post-media

# Сервисные пользователи БД (создаются *-db-security миграциями).
AUTH_DB_APP_USER=auth_app
AUTH_DB_APP_PASSWORD=auth_app_pwd
PROFILE_DB_APP_USER=profile_app
PROFILE_DB_APP_PASSWORD=profile_app_pwd
CONTENT_DB_APP_USER=content_app
CONTENT_DB_APP_PASSWORD=content_app_pwd

# Stripe — заглушки, платежи в тесте не вызываются.
CONTENT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_RETURN_URL=https://example.com/success
STRIPE_CANCEL_URL=https://example.com/cancel
